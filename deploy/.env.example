# Romeka S deployment settings. Copy this file to .env and edit it:
#
#     cp .env.example .env
#
# Every value here reaches the container. DEPLOY.md is the runbook.

# The public hostname the certificate is issued for. It must resolve to this
# server, and ports 80 and 443 must reach it from the internet.
ROMEKA_DOMAIN=collections.example.org

# The origin a browser uses. It must match ROMEKA_DOMAIN exactly, because the
# session cookie is SameSite=Lax and the server refuses a cookie-carrying write
# whose Origin is not this value, and because every JSON-LD @id is built from
# it. A wrong base URL breaks sign-in in a way that looks like a server bug.
ROMEKA_BASE_URL=https://collections.example.org

# The ACME account contact. Certificate-expiry notices go here. Required: an
# empty value stops the origin from parsing its config.
ROMEKA_ACME_EMAIL=ops@example.org

# The host ports to publish. Leave them unless something else on the server
# already holds 80 or 443; a non-standard 443 also breaks the HTTP redirect the
# origin answers on 80, which still names 443.
ROMEKA_HTTP_PORT=80
ROMEKA_HTTPS_PORT=443

# The image to run. A rollback sets this to the previous tag (DEPLOY.md).
ROMEKA_IMAGE=romeka-s:local

# The first administrator. Read only when the database is empty, so changing the
# password here later changes nothing; use `romeka user set-password` for that.
# The password has no default: an empty one stops the first start with a message
# rather than creating an account anyone can sign in to.
ROMEKA_ADMIN_EMAIL=admin@example.org
ROMEKA_ADMIN_NAME=Curator
ROMEKA_ADMIN_PASSWORD=

# Written into the installation settings at install: the site title, the time
# zone and the locale. The install rewrites all three, so keep them accurate.
ROMEKA_TITLE=Romeka S
ROMEKA_TIME_ZONE=UTC
ROMEKA_LOCALE=en

# Log level: off, error, warn, info, debug or trace.
ROMEKA_LOG=info
# Largest accepted request body, in bytes. 268435456 is 256 MiB, the default.
ROMEKA_MAX_BODY_BYTES=268435456
# Seconds a request may run before the server answers 408.
ROMEKA_REQUEST_TIMEOUT_SECS=30

# Mail is optional. With no ROMEKA_SMTP_HOST the server writes the invitation
# and password-reset links to its log and returns them to the administrator, so
# a deployment with no relay still onboards users. Set the host to send mail.
ROMEKA_SMTP_HOST=
# Empty means the port the TLS mode implies: 587 for starttls, 465 for tls.
ROMEKA_SMTP_PORT=
ROMEKA_SMTP_USER=
ROMEKA_SMTP_PASSWORD=
# starttls, tls or none. Empty means starttls.
ROMEKA_SMTP_TLS=
# The envelope sender of every message the server sends.
ROMEKA_MAIL_FROM=no-reply@collections.example.org

# The database file and the media store. The volumes in compose.yaml are mounted
# at these paths, so changing them means changing the volumes too.
ROMEKA_DB=/db/romeka.db
ROMEKA_STORE=/data/files

# ROMEKA_MODE is not a setting here: it is set per command. The image defaults
# it to `serve`; `install` runs the install and the schema migrations against an
# existing database and stops, which is what the upgrade procedure in DEPLOY.md
# uses.
