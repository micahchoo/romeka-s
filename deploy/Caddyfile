# The origin in front of the server: TLS for {$ROMEKA_DOMAIN}, the admin SPA
# and the media bytes as files, and the server's own routes forwarded.
#
# Caddy reads the environment itself, so this file needs no rendering. It uses
# ROMEKA_DOMAIN, ROMEKA_ACME_EMAIL, ROMEKA_TRUSTED_PROXIES, ROMEKA_DIST,
# ROMEKA_STORE, ROMEKA_API_HOST and ROMEKA_API_PORT, all of which
# deploy/compose.yaml sets from deploy/.env.example.
#
# ROMEKA_DOMAIN=:80 serves plain HTTP on :80 for any host name, which is the
# shape for a deployment behind a proxy that already terminates TLS
# (deploy/PORTAINER.md, "Behind a proxy you already run").
#
# It listens on :80 and :443 inside the container. compose publishes those two
# ports on the host; nothing else leaves the container.
{
	# Nothing outside this container talks to the admin API, and a config edit
	# is a container restart.
	admin off
	# The container is non-root with a read-only root filesystem, so the local
	# CA's root certificate can never be installed into the system trust store.
	# This turns the failed attempt into nothing: the internal CA is only used
	# for a localhost deployment.
	skip_install_trust
	# The ACME account contact. Only a certificate-expiry notice uses it.
	email {$ROMEKA_ACME_EMAIL}
	# The proxies whose X-Forwarded-For this origin believes. Empty trusts
	# none, so {client_ip} is the socket peer: right for a container that
	# faces the internet itself. Behind another proxy, name its addresses
	# (`private_ranges` covers a Docker network), and {client_ip} is the
	# rightmost address in the header that is not one of them.
	servers {
		trusted_proxies static {$ROMEKA_TRUSTED_PROXIES}
		trusted_proxies_strict
	}
}

# Automatic HTTPS: Caddy obtains and renews the certificate for this name,
# answers the ACME challenge on :80, and stores the account and the certificate
# under $XDG_DATA_HOME/caddy, which is the romeka-caddy volume. Losing that
# volume re-issues every certificate, and a CA rate-limits that.
{$ROMEKA_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"

	root * {$ROMEKA_DIST}

	# The SPA's bundle lives under the same /assets prefix as the bundled
	# theme's files (`crates/omeka-server/src/assets.rs` serves /assets/<path>
	# from the theme registry). A file the bundle ships wins; every other path
	# under the prefix is the theme's, or a 404 from the server.
	@spa_asset {
		path /assets/*
		file {path}
	}
	handle @spa_asset {
		file_server
	}

	# The server's routes, forwarded unchanged. The Origin, Referer and Cookie
	# headers reach it untouched on purpose: the session cookie is SameSite=Lax,
	# and the server refuses a cookie-carrying write whose Origin is not the
	# configured base URL, so a proxy that rewrites Origin breaks sign-in.
	# Caddy sets X-Forwarded-For to the address it saw, and the server's login
	# limit reads the last entry of that header.
	# Caddy streams the body to the server and sets no size limit of its own, so
	# the server's max_body_bytes is the one cap on an upload.
	# /vocab/* is the published term lists and vocabularies, served in whatever
	# syntax the Accept header asks for, so the proxy must not answer it itself.
	# /logout is the public site's Logout form, a POST the server answers.
	# /iiif-viewer is the Mirador page and /iiif/* the IIIF manifests and images.
	# /annotations is the Web Annotation Protocol server, which the admin loads
	# from the same origin as the app, so a cookie-authenticated write reaches it.
	# /application/asset/* is upstream's fallback thumbnails, which the API
	# links for a media with no thumbnail of its own.
	# The server's login limit reads X-Real-IP before X-Forwarded-For, and
	# Caddy passes a client's own X-Real-IP through, so it is set here from
	# {client_ip}: a caller cannot name its own address to the limit.
	@app path /api /api/* /api-context /assets/* /health /ready /logout /s /s/* /vocab /vocab/* /admin /admin/ /iiif-viewer /iiif/* /annotations /annotations/* /application/asset/*
	handle @app {
		reverse_proxy {$ROMEKA_API_HOST}:{$ROMEKA_API_PORT} {
			header_up X-Real-IP {client_ip}
		}
	}

	# The store the server wrote: /files/original/<name>.<ext>, the thumbnail
	# directories and the assets. A miss is a 404 here, never the SPA shell.
	#
	# Upstream serves every file to anyone. Here the server answers first
	# whether this caller may see the resource that owns the file: 204 serves
	# it, 403 or 404 is the answer the client gets. forward_auth sends the
	# request's cookies and its URI (X-Forwarded-Uri, which carries an API key
	# pair in the query string), never its body.
	#
	# `route` keeps the order as written: the auth check sees the URI before
	# the /files prefix is stripped.
	handle /files/* {
		route {
			# Set before the check, so a refusal carries it too.
			header X-Content-Type-Options nosniff

			# Only the server's answer may mark a request private or name its
			# type and download name.
			request_header -X-Romeka-Private
			request_header -X-Romeka-Content-Type
			request_header -X-Romeka-Content-Disposition
			forward_auth {$ROMEKA_API_HOST}:{$ROMEKA_API_PORT} {
				uri /api/romeka/files/allow
				copy_headers X-Romeka-Private X-Romeka-Content-Type X-Romeka-Content-Disposition
			}

			# The media's stored o:media_type is the answer, not the
			# extension: .webm alone cannot say video from audio, and .mov and
			# .glb had no type at all without /etc/mime.types. The ingest has
			# already named the formats a byte read cannot (WebVTT, SubRip,
			# glTF, GLB, Ogg Theora), so the row is the one authority. An empty
			# value removes the header, and file_server then falls back to the
			# extension for a row that stored no type.
			header Content-Type "{http.request.header.X-Romeka-Content-Type}"
			header Content-Disposition "{http.request.header.X-Romeka-Content-Disposition}"

			# A private file must not sit in a shared cache, and one user's copy
			# must not answer another user's request.
			@private header X-Romeka-Private 1
			header @private Cache-Control private
			header @private +Vary Cookie

			# An original's name is its content id, which no later write
			# reuses, so a public one may sit in any cache for a year.
			@public_original {
				path /files/original/*
				not header X-Romeka-Private 1
			}
			header @public_original Cache-Control "public, max-age=31536000, immutable"

			# A stored file that a browser would run as a document (HTML, SVG,
			# XML) is inert when opened directly: no script, no subresource, a
			# sandboxed document. The stored SVG is already filtered at ingest;
			# this is the second line. It is scoped to these types because a
			# sandbox on a PDF or media file opened in its own tab is not proven
			# to leave the browser's viewer working, so a new active type must be
			# added to this matcher.
			@active path *.html *.htm *.svg *.xml
			header @active Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; sandbox"

			uri strip_prefix /files
			root * {$ROMEKA_STORE}
			file_server
		}
	}

	# Everything else is the admin SPA. A path that names a file is served or
	# 404s; a path with no extension falls back to the shell, so a reload of an
	# SPA route lands on the app rather than a 404. The shell is revalidated on
	# every load (no-cache), so a deploy reaches an open browser at its next
	# load; the hashed files under /assets it names may stay cached.
	handle {
		@extensionless not path_regexp extension \.[^/]+$
		handle @extensionless {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
		handle {
			header /index.html Cache-Control "no-cache"
			file_server
		}
	}
}
