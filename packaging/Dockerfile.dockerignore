# Build context for packaging/Dockerfile. BuildKit reads the ignore file named
# after the Dockerfile, so the filter stays next to the Dockerfile it belongs to
# and the repository root needs no second one.
#
# The stages read Cargo.toml, Cargo.lock, crates/, web/admin/ and deploy/Caddyfile.
# Everything else is dropped to keep the context small.

.git
.gitignore
.github

# The reference clone and build output.
source
target
**/target
**/node_modules
**/dist

# Read by no stage.
briefs
docs
deploy/.env.example
deploy/DEPLOY.md
deploy/backup.sh
deploy/restore.sh
deploy/compose.yaml
deploy/smoke.sh
packaging/README.md
