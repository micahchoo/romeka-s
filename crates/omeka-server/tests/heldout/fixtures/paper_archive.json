{
  "version": 3,
  "sources": [{ "kind": "folder", "id": "s1", "root": "archive", "path": "" }],
  "structure": {
    "levels": [
      {
        "kind": "series",
        "id": "papers",
        "set": null,
        "scope": [
          { "source": "s1", "folder": "Box 01" },
          { "source": "s1", "folder": "Box 02" },
          { "source": "s1", "folder": "Box 03" },
          { "source": "s1", "folder": "Oversize" }
        ],
        "grouping": {
          "pattern": "^(?<identifier>PFP-\\d{2}-\\d{2}) [^/]+(?:/[^/]+)?$",
          "caseFold": false
        },
        "example": null,
        "lists": [
          {
            "id": "containers", "source": "s1", "file": "container-list.xlsx", "hash": null,
            "read": { "encoding": "auto", "delimiter": "auto", "quote": "\"", "headerLine": 1, "trim": true },
            "rowKind": "item",
            "join": {
              "on": "identifier",
              "column": { "index": 0, "header": "Ref" },
              "normalize": { "caseFold": false, "leadingZeros": true, "separators": false }
            },
            "itemKey": null,
            "columns": [
              { "column": { "index": 3, "header": "Title" },
                "options": { "split": null, "type": "literal", "lang": null, "private": false } },
              { "column": { "index": 4, "header": "Dates" },
                "options": { "split": null, "type": "literal", "lang": null, "private": false } },
              { "column": { "index": 5, "header": "Series" },
                "options": { "split": null, "type": "literal", "lang": null, "private": false } },
              { "column": { "index": 6, "header": "Extent" },
                "options": { "split": null, "type": "literal", "lang": null, "private": false } }
            ]
          }
        ],
        "slots": {
          "item": {
            "dcterms:title": {
              "sources": [{ "from": "column", "sheet": "containers", "column": { "index": 3, "header": "Title" } }],
              "combine": "first"
            },
            "dcterms:date": {
              "sources": [{ "from": "column", "sheet": "containers", "column": { "index": 4, "header": "Dates" } }],
              "combine": "first"
            },
            "dcterms:extent": {
              "sources": [{ "from": "column", "sheet": "containers", "column": { "index": 6, "header": "Extent" } }],
              "combine": "first"
            }
          },
          "media": {},
          "itemSet": {}
        }
      }
    ],
    "freeSets": [
      { "each": {
          "sources": [{ "from": "column", "sheet": "containers", "column": { "index": 5, "header": "Series" } }],
          "combine": "first",
          "names": "title"
      } }
    ]
  },
  "action": {
    "action": "create",
    "match": {
      "item": { "key": "dcterms:identifier", "scope": "importSets" },
      "media": { "key": "dcterms:identifier", "scope": "importSets" },
      "itemSet": { "key": "dcterms:identifier", "scope": "importSets" }
    },
    "unmatched": "leave"
  },
  "defaults": { "visibility": "private", "owner": "runner", "sites": [], "template": null },
  "flags": { "no-file": "leave" },
  "decisions": [],
  "newTypes": [],
  "newTerms": []
}
